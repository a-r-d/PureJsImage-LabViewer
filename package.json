{
  "name": "purejsimage-materials-workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @pji-workbench/science dev",
    "dev:workbench": "corepack pnpm --filter @pji-workbench/science dev",
    "dev:science": "corepack pnpm --filter @pji-workbench/science dev",
    "dev:gallery": "corepack pnpm --filter @pji-workbench/gallery dev",
    "dev:geo": "corepack pnpm --filter @pji-workbench/geo dev",
    "build": "turbo run build && node tooling/scripts/check-bundle-budget.mjs",
    "build:science": "corepack pnpm --filter @pji-workbench/science build",
    "build:gallery": "corepack pnpm --filter @pji-workbench/gallery build",
    "build:geo": "corepack pnpm --filter @pji-workbench/geo build",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build && corepack pnpm test:e2e && corepack pnpm deploy:dry-run",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && node tooling/scripts/check-boundaries.mjs && node tooling/scripts/check-static-security.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:science": "vitest run apps/science packages/domain-science",
    "test:gallery": "vitest run apps/gallery",
    "test:geo": "vitest run apps/geo packages/domain-geo",
    "test:e2e": "playwright test && playwright test -c playwright.geo.config.ts",
    "test:a11y": "playwright test --grep @a11y --project=chromium",
    "test:visual": "playwright test --grep @visual --project=chromium && playwright test -c playwright.geo.config.ts --grep @visual --project=chromium",
    "test:corpus": "corepack pnpm --filter @pji-workbench/test-corpus test",
    "test:performance": "playwright test --grep @performance --project=chromium",
    "test:sandbox": "corepack pnpm --filter @pji-workbench/scripts test",
    "test:sandbox:release": "corepack pnpm --filter @pji-workbench/scripts test:release",
    "test:sandbox:debug": "corepack pnpm --filter @pji-workbench/scripts test:debug",
    "deploy:production": "corepack pnpm --filter @pji-workbench/science deploy:production",
    "deploy:science": "corepack pnpm --filter @pji-workbench/science exec wrangler deploy",
    "deploy:geo": "corepack pnpm --filter @pji-workbench/geo exec wrangler deploy",
    "deploy:gallery": "corepack pnpm --filter @pji-workbench/gallery exec wrangler deploy",
    "deploy:dry-run": "corepack pnpm --filter @pji-workbench/science deploy:dry-run && corepack pnpm --filter @pji-workbench/geo deploy:dry-run && corepack pnpm --filter @pji-workbench/gallery deploy:dry-run",
    "boundaries": "node tooling/scripts/check-boundaries.mjs",
    "security:static": "node tooling/scripts/check-static-security.mjs",
    "bundle:check": "node tooling/scripts/check-bundle-budget.mjs",
    "clean": "turbo run clean && node tooling/scripts/clean-root.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "turbo": "2.10.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
