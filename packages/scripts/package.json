{
  "name": "@pji-workbench/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./examples": {
      "types": "./src/examples.ts",
      "import": "./src/examples.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "lint": "biome check src tests",
    "typecheck": "tsc --noEmit --composite false --incremental false -p tsconfig.json",
    "test": "vitest run --root ../.. packages/scripts",
    "test:release": "vitest run --root ../.. packages/scripts/tests/release.test.ts",
    "test:debug": "vitest run --root ../.. packages/scripts/tests/debug.test.ts",
    "clean": "node ../../tooling/scripts/clean-package.mjs"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.31.0",
    "@pji-workbench/actions": "workspace:*",
    "@pji-workbench/plugin-sdk": "workspace:*",
    "quickjs-emscripten-core": "0.31.0"
  },
  "devDependencies": {
    "@jitl/quickjs-wasmfile-debug-sync": "0.31.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
