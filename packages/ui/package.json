{
  "name": "@pji-workbench/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "lint": "biome check src tests",
    "typecheck": "tsc --noEmit --composite false --incremental false -p tsconfig.json",
    "test": "vitest run --root ../.. packages/ui",
    "clean": "node ../../tooling/scripts/clean-package.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": "19.2.8"
  }
}
