    {
      "cancellable": true,
      "category": "analysis",
      "cost": "expensive",
      "description": "Validate, execute, and visibly commit the complete particle workflow for a bounded settings patch.",
      "id": "analysis.particle.execute",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "planId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "settings": {
            "additionalProperties": false,
            "properties": {
              "backgroundRadius": {
                "maximum": 64,
                "minimum": 0,
                "type": "integer"
              },
              "clearBorder": {
                "type": "boolean"
              },
              "closeRadius": {
                "maximum": 64,
                "minimum": 0,
                "type": "integer"
              },
              "component": {
                "maximum": 4095,
                "minimum": 0,
                "type": "integer"
              },
              "connectivity": {
                "enum": [4, 8],
                "type": "integer"
              },
              "dynamicRange": {
                "minimum": 0.000001,
                "type": "number"
              },
              "edgePolicy": {
                "enum": ["include", "exclude"],
                "type": "string"
              },
              "fillHoles": {
                "type": "boolean"
              },
              "histogramBins": {
                "maximum": 65536,
                "minimum": 16,
                "type": "integer"
              },
              "lower": {
                "type": "number"
              },
              "maximumArea": {
                "minimum": 0,
                "type": "number"
              },
              "maximumAspectRatio": {
                "minimum": 1,
                "type": "number"
              },
              "maximumCircularity": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "maximumSolidity": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "minimumArea": {
                "minimum": 0,
                "type": "number"
              },
              "minimumAspectRatio": {
                "minimum": 1,
                "type": "number"
              },
              "minimumCircularity": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "minimumObjectPixels": {
                "maximum": 1000000000,
                "minimum": 1,
                "type": "integer"
              },
              "minimumPeakDistance": {
                "maximum": 4096,
                "minimum": 1,
                "type": "integer"
              },
              "minimumSolidity": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "noDataPolicy": {
                "enum": ["background", "foreground", "propagate"],
                "type": "string"
              },
              "openRadius": {
                "maximum": 64,
                "minimum": 0,
                "type": "integer"
              },
              "overlayView": {
                "enum": ["labels", "mask", "outline", "numbered", "centroids", "ellipses"],
                "type": "string"
              },
              "polarity": {
                "enum": ["light", "dark"],
                "type": "string"
              },
              "roiId": {
                "maxLength": 256,
                "type": "string"
              },
              "sauvolaK": {
                "maximum": 1,
                "minimum": -1,
                "type": "number"
              },
              "thresholdMethod": {
                "enum": ["manual", "otsu", "triangle", "yen", "li", "mean", "sauvola"],
                "type": "string"
              },
              "upper": {
                "type": "number"
              },
              "watershed": {
                "type": "boolean"
              },
              "windowRadius": {
                "maximum": 128,
                "minimum": 1,
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "required": ["planId", "settings"],
        "type": "object"
      },
      "mutability": "mutation",
      "outputSchema": {
        "type": "object"
      },
      "permissions": ["analysis.execute"],
      "schemaVersion": 1,
      "title": "Execute particle analysis settings",
      "version": 1
    },
